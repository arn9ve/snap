{
  "manifest_version": 3,
  "name": "Snap",
  "version": "0.3.1",
  "description": "Snap your fingers and vanish from your own video in Google Meet, with 6 effects. You stay in the call.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "commands": {
    "toggle-vanish": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Vanish / return"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn Snap on / off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "effect.js",
        "effects.js",
        "snapdetect.js",
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "snap-worklet.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
