{
  "manifest_version": 3,
  "name": "Snap",
  "version": "0.1.0",
  "description": "Snap your fingers and vanish from your own video in Google Meet. You stay in the call.",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["effect.js", "snapdetect.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
